# Reglas de estilo de YoshiSQL (ver docs/Convenciones.md)
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,axaml}]
indent_size = 4

[*.{csproj,props,xml,xshd,json}]
indent_size = 2

[*.cs]
# Espacios de nombres por archivo y usings fuera
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Llaves siempre presentes y en línea nueva
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all

# var solo cuando el tipo es evidente
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion

# --- Convenciones de nombres ---
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefijo_i.required_prefix = I
dotnet_naming_style.prefijo_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_con_i.symbols = interfaces
dotnet_naming_rule.interfaces_con_i.style = prefijo_i
dotnet_naming_rule.interfaces_con_i.severity = warning

dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_symbols.campos_privados.required_modifiers = readonly
dotnet_naming_style.guion_bajo.required_prefix = _
dotnet_naming_style.guion_bajo.capitalization = camel_case
dotnet_naming_rule.campos_privados_con_guion.symbols = campos_privados
dotnet_naming_rule.campos_privados_con_guion.style = guion_bajo
dotnet_naming_rule.campos_privados_con_guion.severity = warning

dotnet_naming_symbols.tipos_y_miembros.applicable_kinds = class, struct, enum, property, method, event, delegate
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.tipos_en_pascal.symbols = tipos_y_miembros
dotnet_naming_rule.tipos_en_pascal.style = pascal
dotnet_naming_rule.tipos_en_pascal.severity = warning

dotnet_naming_symbols.locales_y_parametros.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.locales_en_camel.symbols = locales_y_parametros
dotnet_naming_rule.locales_en_camel.style = camel
dotnet_naming_rule.locales_en_camel.severity = warning

# Las pruebas se nombran Metodo_Escenario_ResultadoEsperado
[pruebas/**.cs]
dotnet_naming_rule.tipos_en_pascal.severity = none

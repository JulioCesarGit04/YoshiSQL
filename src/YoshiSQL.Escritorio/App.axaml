<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YoshiSQL.Escritorio.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Estilos/Colores.axaml" />
                <ResourceInclude Source="/Estilos/Iconos.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#6CC24A"
                                       AltHigh="#16181B"
                                       RegionColor="#1C1E22"
                                       ChromeMediumLow="#25282D"
                                       ChromeMedium="#2A2D33"
                                       ChromeLow="#2E3238"
                                       BaseHigh="#DFE2E7"
                                       ErrorText="#F07178" />
                <ColorPaletteResources x:Key="Light"
                                       Accent="#2F8132"
                                       RegionColor="#FFFFFF"
                                       BaseHigh="#1F2328"
                                       ErrorText="#C8323C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="/Estilos/Controles.axaml" />
    </Application.Styles>
</Application>

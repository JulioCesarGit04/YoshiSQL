<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YoshiSQL.Escritorio.ModelosDeVista.Paleta"
        x:Class="YoshiSQL.Escritorio.Vistas.Comunes.DialogoDePaleta"
        x:DataType="vm:PaletaDeComandosModeloDeVista"
        Width="580" Height="420"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource PincelDePanel}" BorderBrush="{DynamicResource PincelDeBorde}"
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="28" OffsetY="8" />
        </Border.Effect>
        <DockPanel Margin="10">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="2,2,2,8">
                <Path Classes="Icono IconoBarra" Data="{StaticResource IconoBuscar}" Margin="6,0,8,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="CajaDeBusqueda" Text="{Binding Filtro}" BorderThickness="0"
                         FontSize="15" Background="Transparent"
                         PlaceholderText="Escribe una acción... (Esc para cerrar)" />
            </Grid>

            <ListBox x:Name="ListaDeComandos" ItemsSource="{Binding Resultados}" SelectedItem="{Binding Seleccionado}"
                     Background="Transparent" BorderThickness="0" DoubleTapped="AlHacerDobleClic">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComandoDePaleta">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Atajo}" FontSize="11.5"
                                       Foreground="{DynamicResource PincelDeTextoSecundario}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="YoshiSQL.Escritorio.Vistas.Comunes.DialogoDeMensaje"
        Width="440" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24,20" Spacing="18">
        <SelectableTextBlock x:Name="TextoDelMensaje" TextWrapping="Wrap" />
        <StackPanel x:Name="PanelDeBotones" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
    </StackPanel>
</Window>

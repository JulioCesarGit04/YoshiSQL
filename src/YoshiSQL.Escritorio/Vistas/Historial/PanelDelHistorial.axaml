<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoshiSQL.Escritorio.ModelosDeVista.Historial"
             x:Class="YoshiSQL.Escritorio.Vistas.Historial.PanelDelHistorial"
             x:DataType="vm:HistorialModeloDeVista"
             Background="{StaticResource PincelDePanel}">

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="10,8">
            <TextBox Text="{Binding Filtro}" PlaceholderText="Buscar en el historial" />
            <Button Grid.Column="1" Classes="Herramienta" Content="Borrar todo"
                    Command="{Binding BorrarTodoCommand}" IsEnabled="{Binding !EstaVacio}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding EstaVacio}" Margin="12,4" TextWrapping="Wrap"
                   Foreground="{StaticResource PincelDeTextoSecundario}"
                   Text="Aquí aparecerán las consultas que ejecutes." />

        <ListBox ItemsSource="{Binding Entradas}"
                 SelectedItem="{Binding EntradaSeleccionada}"
                 Background="Transparent"
                 DoubleTapped="AlHacerDobleClicEnEntrada">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EntradaDelHistorialModeloDeVista">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Background="Transparent"
                          ToolTip.Tip="{Binding VistaPrevia}">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Abrir en nueva consulta" Command="{Binding AbrirCommand}" />
                                <MenuItem Header="Copiar" Command="{Binding CopiarCommand}" />
                                <Separator />
                                <MenuItem Header="Eliminar del historial" Command="{Binding EliminarCommand}" />
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Ellipse Width="6" Height="6" Margin="0,6,0,0" VerticalAlignment="Top"
                                 Fill="{StaticResource PincelDeAcento}" IsVisible="{Binding !TerminoConErrores}" />
                        <Ellipse Width="6" Height="6" Margin="0,6,0,0" VerticalAlignment="Top"
                                 Fill="{StaticResource PincelDeError}" IsVisible="{Binding TerminoConErrores}" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Resumen}" FontFamily="{StaticResource FuenteMonoespaciada}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detalle}" FontSize="11"
                                       Foreground="{StaticResource PincelDeTextoSecundario}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

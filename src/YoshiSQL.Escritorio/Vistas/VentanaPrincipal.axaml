<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YoshiSQL.Escritorio.ModelosDeVista"
        xmlns:editor="using:YoshiSQL.Escritorio.ModelosDeVista.Editor"
        xmlns:vistasExplorador="using:YoshiSQL.Escritorio.Vistas.Explorador"
        xmlns:vistasHistorial="using:YoshiSQL.Escritorio.Vistas.Historial"
        xmlns:vistasFavoritos="using:YoshiSQL.Escritorio.Vistas.Favoritos"
        xmlns:vistasEditor="using:YoshiSQL.Escritorio.Vistas.Editor"
        xmlns:diagramas="using:YoshiSQL.Escritorio.ModelosDeVista.Diagramas"
        xmlns:vistasDiagramas="using:YoshiSQL.Escritorio.Vistas.Diagramas"
        xmlns:diseno="using:YoshiSQL.Escritorio.ModelosDeVista.DisenoDeTablas"
        xmlns:vistasDiseno="using:YoshiSQL.Escritorio.Vistas.DisenoDeTablas"
        xmlns:edicion="using:YoshiSQL.Escritorio.ModelosDeVista.EdicionDeFilas"
        xmlns:vistasEdicion="using:YoshiSQL.Escritorio.Vistas.EdicionDeFilas"
        xmlns:administracion="using:YoshiSQL.Escritorio.ModelosDeVista.Administracion"
        xmlns:vistasAdministracion="using:YoshiSQL.Escritorio.Vistas.Administracion"
        xmlns:modeloSalud="using:YoshiSQL.Escritorio.ModelosDeVista.Salud"
        xmlns:vistasSalud="using:YoshiSQL.Escritorio.Vistas.Salud"
        xmlns:conv="using:YoshiSQL.Escritorio.Convertidores"
        xmlns:controles="using:YoshiSQL.Escritorio.Controles"
        x:Class="YoshiSQL.Escritorio.Vistas.VentanaPrincipal"
        x:DataType="vm:VentanaPrincipalModeloDeVista"
        Title="YoshiSQL"
        Icon="/Recursos/logo.png"
        Width="1360" Height="820"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <!-- Vista de cada tipo de documento que se abre en una pestaña -->
    <Window.DataTemplates>
        <DataTemplate DataType="editor:PestanaDeConsultaModeloDeVista">
            <vistasEditor:PestanaDeConsulta />
        </DataTemplate>
        <DataTemplate DataType="diagramas:PestanaDeDiagramaModeloDeVista">
            <vistasDiagramas:PestanaDeDiagrama />
        </DataTemplate>
        <DataTemplate DataType="diseno:PestanaDeDisenoDeTablaModeloDeVista">
            <vistasDiseno:PestanaDeDisenoDeTabla />
        </DataTemplate>
        <DataTemplate DataType="edicion:PestanaDeEdicionDeFilasModeloDeVista">
            <vistasEdicion:PestanaDeEdicionDeFilas />
        </DataTemplate>
        <DataTemplate DataType="administracion:PestanaDeMonitorModeloDeVista">
            <vistasAdministracion:PestanaDeMonitor />
        </DataTemplate>
        <DataTemplate DataType="modeloSalud:PestanaDeSaludModeloDeVista">
            <vistasSalud:PestanaDeSalud />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding AbrirPaletaDeComandosCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding AbrirPaletaDeComandosCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ConsultaSeleccionada.EjecutarCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ConsultaSeleccionada.EjecutarCommand}" />
        <KeyBinding Gesture="Alt+Pause" Command="{Binding ConsultaSeleccionada.CancelarCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NuevaConsultaCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AbrirArchivoCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding GuardarCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding GuardarComoCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CerrarPestanaCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding MostrarPreferenciasCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding ConsultaSeleccionada.ReemplazarCommand}" />
        <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding ConsultaSeleccionada.AlternarComentarioCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+U" Command="{Binding ConsultaSeleccionada.ConvertirAMayusculasCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding ConsultaSeleccionada.ConvertirAMinusculasCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ConsultaSeleccionada.FormatearCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ConsultaSeleccionada.MostrarPlanEstimadoCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ConsultaSeleccionada.ConmutarPlanRealCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ConsultaSeleccionada.ConmutarResultadosEnTextoCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Menú -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PincelDePanel}" Padding="4,0">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Paleta de comandos..." InputGesture="Ctrl+Shift+P" Command="{Binding AbrirPaletaDeComandosCommand}" />
                <Separator />
                <MenuItem Header="Conectar al servidor..." Command="{Binding ConectarCommand}" />
                <Separator />
                <MenuItem Header="Nueva consulta" InputGesture="Ctrl+N" Command="{Binding NuevaConsultaCommand}" />
                <MenuItem Header="Abrir..." InputGesture="Ctrl+O" Command="{Binding AbrirArchivoCommand}" />
                <MenuItem Header="Guardar" InputGesture="Ctrl+S" Command="{Binding GuardarCommand}" />
                <MenuItem Header="Guardar como..." InputGesture="Ctrl+Shift+S" Command="{Binding GuardarComoCommand}" />
                <Separator />
                <MenuItem Header="Cerrar pestaña" InputGesture="Ctrl+W" Command="{Binding CerrarPestanaCommand}" />
                <Separator />
                <MenuItem Header="Preferencias..." InputGesture="Ctrl+OemComma" Command="{Binding MostrarPreferenciasCommand}" />
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="Buscar..." InputGesture="Ctrl+F" Command="{Binding ConsultaSeleccionada.BuscarCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <MenuItem Header="Reemplazar..." InputGesture="Ctrl+H" Command="{Binding ConsultaSeleccionada.ReemplazarCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <Separator />
                <MenuItem Header="Comentar selección" Command="{Binding ConsultaSeleccionada.ComentarCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <MenuItem Header="Descomentar selección" Command="{Binding ConsultaSeleccionada.DescomentarCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <MenuItem Header="Comentar o descomentar" InputGesture="Ctrl+OemQuestion" Command="{Binding ConsultaSeleccionada.AlternarComentarioCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <MenuItem Header="Pasar a MAYÚSCULAS" InputGesture="Ctrl+Shift+U" Command="{Binding ConsultaSeleccionada.ConvertirAMayusculasCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <MenuItem Header="Pasar a minúsculas" InputGesture="Ctrl+Shift+L" Command="{Binding ConsultaSeleccionada.ConvertirAMinusculasCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <Separator />
                <MenuItem Header="Formatear SQL" InputGesture="Ctrl+Shift+F" Command="{Binding ConsultaSeleccionada.FormatearCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
                <Separator />
                <MenuItem Header="Guardar como favorito..." Command="{Binding GuardarComoFavoritoCommand}"
                          IsEnabled="{Binding HayConsultaSeleccionada}" />
            </MenuItem>
            <MenuItem Header="_Consulta">
                <MenuItem Header="Ejecutar" InputGesture="F5" Command="{Binding ConsultaSeleccionada.EjecutarCommand}" />
                <MenuItem Header="Cancelar ejecución" InputGesture="Alt+Pause" Command="{Binding ConsultaSeleccionada.CancelarCommand}" />
                <Separator />
                <MenuItem Header="Mostrar plan estimado" InputGesture="Ctrl+L" Command="{Binding ConsultaSeleccionada.MostrarPlanEstimadoCommand}" />
                <MenuItem Header="Incluir plan real" InputGesture="Ctrl+M" Command="{Binding ConsultaSeleccionada.ConmutarPlanRealCommand}" />
                <MenuItem Header="Incluir estadísticas (IO y tiempo)" ToggleType="CheckBox"
                          IsChecked="{Binding ConsultaSeleccionada.IncluirEstadisticas}" />
                <Separator />
                <MenuItem Header="Resultados en texto" InputGesture="Ctrl+T" Command="{Binding ConsultaSeleccionada.ConmutarResultadosEnTextoCommand}" />
            </MenuItem>
            <MenuItem Header="A_yuda">
                <MenuItem Header="Abrir carpeta de registros" Command="{Binding AbrirCarpetaDeRegistrosCommand}" />
                <Separator />
                <MenuItem Header="Acerca de YoshiSQL" Command="{Binding MostrarAcercaDeCommand}" />
            </MenuItem>
        </Menu>

        <!-- Barra de herramientas -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PincelDePanel}"
                BorderBrush="{DynamicResource PincelDeBorde}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="Herramienta" Command="{Binding ConectarCommand}" ToolTip.Tip="Conectar al servidor">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="Icono IconoBarra" Data="{StaticResource IconoConectar}" />
                        <TextBlock Text="Conectar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Herramienta" Command="{Binding NuevaConsultaCommand}" ToolTip.Tip="Nueva consulta (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="Icono IconoBarra" Data="{StaticResource IconoNuevaConsulta}" />
                        <TextBlock Text="Nueva" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Herramienta" Command="{Binding AbrirArchivoCommand}" ToolTip.Tip="Abrir archivo (Ctrl+O)">
                    <Path Classes="Icono IconoBarra" Data="{StaticResource IconoAbrir}" />
                </Button>
                <Button Classes="Herramienta" Command="{Binding GuardarCommand}" IsEnabled="{Binding HayConsultaSeleccionada}"
                        ToolTip.Tip="Guardar (Ctrl+S)">
                    <Path Classes="Icono IconoBarra" Data="{StaticResource IconoGuardar}" />
                </Button>

                <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource PincelDeBorde}" />

                <ComboBox MinWidth="180"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding HayConsultaSeleccionada}"
                          ItemsSource="{Binding ConsultaSeleccionada.BasesDeDatosDisponibles}"
                          SelectedItem="{Binding ConsultaSeleccionada.BaseDeDatosSeleccionada}"
                          ToolTip.Tip="Base de datos de la pestaña actual" />

                <Button Classes="Herramienta Ejecutar" Command="{Binding ConsultaSeleccionada.EjecutarCommand}"
                        IsEnabled="{Binding HayConsultaSeleccionada}" ToolTip.Tip="Ejecutar (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="Icono IconoEjecutar" Data="{StaticResource IconoEjecutar}" />
                        <TextBlock Text="Ejecutar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Herramienta" Command="{Binding ConsultaSeleccionada.CancelarCommand}"
                        IsEnabled="{Binding HayConsultaSeleccionada}" ToolTip.Tip="Cancelar ejecución (Alt+Pause)">
                    <Path Classes="Icono IconoBarra" Data="{StaticResource IconoCancelar}" />
                </Button>

                <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource PincelDeBorde}" />

                <Button Classes="Herramienta" Command="{Binding ConsultaSeleccionada.MostrarPlanEstimadoCommand}"
                        IsEnabled="{Binding HayConsultaSeleccionada}"
                        ToolTip.Tip="Ver el plan estimado sin ejecutar (Ctrl+L)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="Icono IconoBarra" Data="{StaticResource IconoPlan}" />
                        <TextBlock Text="Plan" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton Classes="Herramienta" Content="Plan real"
                              IsChecked="{Binding ConsultaSeleccionada.IncluirPlanReal, FallbackValue=False}"
                              IsEnabled="{Binding HayConsultaSeleccionada}"
                              ToolTip.Tip="Incluir el plan real al ejecutar (Ctrl+M)" />
                <Button Classes="Herramienta" Command="{Binding ConsultaSeleccionada.FormatearCommand}"
                        IsEnabled="{Binding HayConsultaSeleccionada}" ToolTip.Tip="Formatear SQL (Ctrl+Shift+F)">
                    <Path Classes="Icono IconoBarra" Data="{StaticResource IconoFormatear}" />
                </Button>
                <Button Classes="Herramienta" Command="{Binding ConsultaSeleccionada.ComentarCommand}"
                        IsEnabled="{Binding HayConsultaSeleccionada}" ToolTip.Tip="Comentar la selección">
                    <Path Classes="Icono IconoBarra" Data="{StaticResource IconoComentar}" />
                </Button>
                <Button Classes="Herramienta" Command="{Binding ConsultaSeleccionada.DescomentarCommand}"
                        IsEnabled="{Binding HayConsultaSeleccionada}" ToolTip.Tip="Descomentar la selección">
                    <Path Classes="Icono IconoBarra" Data="{StaticResource IconoDescomentar}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Barra de estado -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PincelDePanel}"
                BorderBrush="{DynamicResource PincelDeBorde}"
                BorderThickness="0,1,0,0"
                Padding="0">
          <DockPanel>
            <!-- Franja con el color de la conexión (ej. rojo = producción) -->
            <Border DockPanel.Dock="Left" Width="4"
                    Background="{Binding DocumentoSeleccionado.ColorDeLaConexion, Converter={x:Static conv:CadenaHexAPincel.Instancia}}"
                    IsVisible="{Binding DocumentoSeleccionado.ColorDeLaConexion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="12,4">
                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                         Fill="{Binding DocumentoSeleccionado.ColorDeLaConexion, Converter={x:Static conv:CadenaHexAPincel.Instancia}, FallbackValue={DynamicResource PincelDeAcento}, TargetNullValue={DynamicResource PincelDeAcento}}" />
                <TextBlock Grid.Column="1" Text="{Binding DocumentoSeleccionado.TextoDeEstado, FallbackValue='Sin conexión'}" />
                <TextBlock Grid.Column="2" Margin="24,0,0,0" Foreground="{DynamicResource PincelDeTextoSecundario}"
                           Text="{Binding DocumentoSeleccionado.DescripcionDeLaConexion, FallbackValue=''}" />
                <TextBlock Grid.Column="3" Margin="24,0,0,0" Foreground="{DynamicResource PincelDeTextoSecundario}"
                           Text="{Binding ConsultaSeleccionada.BaseDeDatosActual, FallbackValue=''}" />
                <TextBlock Grid.Column="4" Margin="24,0,0,0" Foreground="{DynamicResource PincelDeTextoSecundario}"
                           Text="{Binding ConsultaSeleccionada.DuracionVisible, FallbackValue=''}" />
                <TextBlock Grid.Column="5" Margin="24,0,0,0" Foreground="{DynamicResource PincelDeTextoSecundario}"
                           Text="{Binding ConsultaSeleccionada.TotalDeFilas, StringFormat='{}{0} filas', FallbackValue=''}" />
            </Grid>
          </DockPanel>
        </Border>

        <!-- Explorador a la izquierda, documentos a la derecha -->
        <Grid ColumnDefinitions="300,1,*">
            <TabControl Grid.Column="0" Classes="Laterales" Padding="0" Background="{DynamicResource PincelDePanel}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="Icono IconoBarra" Data="{StaticResource IconoExplorador}" />
                            <TextBlock Text="Explorador" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <vistasExplorador:PanelDelExplorador DataContext="{Binding Explorador}" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="Icono IconoBarra" Data="{StaticResource IconoHistorial}" />
                            <TextBlock Text="Historial" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <vistasHistorial:PanelDelHistorial DataContext="{Binding Historial}" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="Icono IconoBarra" Data="{StaticResource IconoFavoritos}" />
                            <TextBlock Text="Favoritos" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <vistasFavoritos:PanelDeFavoritos DataContext="{Binding Favoritos}" />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <Panel Grid.Column="2">
                <StackPanel IsVisible="{Binding NoHayDocumentosAbiertos}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <controles:LogoDeYoshiSql Width="88" Height="88" HorizontalAlignment="Center" />
                    <TextBlock Text="YoshiSQL" FontSize="32" FontWeight="Light"
                               Foreground="{DynamicResource PincelDeTexto}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="Conéctate a un servidor para empezar"
                               Foreground="{DynamicResource PincelDeTextoSecundario}" HorizontalAlignment="Center" />
                    <Button Classes="Primario" Content="Conectar al servidor" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Command="{Binding ConectarCommand}" />
                    <TextBlock Text="Ctrl+N nueva consulta  ·  F5 ejecutar  ·  Ctrl+Shift+P paleta de comandos"
                               FontSize="11.5" Margin="0,12,0,0"
                               Foreground="{DynamicResource PincelDeTextoSecundario}" HorizontalAlignment="Center" />
                </StackPanel>

                <TabControl Classes="Documentos"
                            IsVisible="{Binding HayDocumentosAbiertos}"
                            ItemsSource="{Binding Documentos}"
                            SelectedItem="{Binding DocumentoSeleccionado}"
                            Padding="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentoModeloDeVista">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Titulo}" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding InformacionAdicional}" />
                                <Button Classes="Herramienta" Padding="4"
                                        ToolTip.Tip="Cerrar (Ctrl+W)"
                                        Command="{Binding $parent[TabControl].((vm:VentanaPrincipalModeloDeVista)DataContext).CerrarPestanaCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Data="M3,3 L9,9 M9,3 L3,9" Stroke="{DynamicResource PincelDeTextoSecundario}"
                                          StrokeThickness="1.3" StrokeLineCap="Round" Width="12" Height="12" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </Panel>
        </Grid>
    </DockPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoshiSQL.Escritorio.ModelosDeVista.Resultados"
             xmlns:consultas="using:YoshiSQL.Dominio.Consultas"
             xmlns:conv="using:YoshiSQL.Escritorio.Convertidores"
             xmlns:resultados="using:YoshiSQL.Escritorio.Vistas.Resultados"
             xmlns:planes="using:YoshiSQL.Escritorio.ModelosDeVista.Planes"
             x:Class="YoshiSQL.Escritorio.Vistas.Resultados.PanelDeResultados"
             x:DataType="vm:ResultadosModeloDeVista"
             Background="{DynamicResource PincelDePanel}">

    <TabControl Classes="Resultados" SelectedIndex="{Binding IndiceDePestanaSeleccionada}" Padding="0">
        <TabItem Header="Resultados">
            <Panel>
                <TextBlock IsVisible="{Binding NoTieneConjuntos}"
                           Margin="12" Foreground="{DynamicResource PincelDeTextoSecundario}"
                           Text="La consulta no devolvió resultados." />

                <resultados:GrillaDeResultados IsVisible="{Binding MostrarGrillaUnica}"
                                               Conjunto="{Binding ConjuntoUnico}" />

                <ScrollViewer IsVisible="{Binding MostrarVariasGrillas}">
                    <ItemsControl ItemsSource="{Binding Conjuntos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConjuntoDeResultadosModeloDeVista">
                                <Border Height="220" Margin="0,0,0,6"
                                        BorderBrush="{DynamicResource PincelDeBorde}" BorderThickness="0,0,0,1">
                                    <resultados:GrillaDeResultados Conjunto="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding MostrarTexto}" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding TextoDeResultados}"
                                         FontFamily="{StaticResource FuenteMonoespaciada}" FontSize="12.5"
                                         Padding="8" />
                </ScrollViewer>
            </Panel>
        </TabItem>

        <TabItem Header="Mensajes">
            <ListBox x:Name="ListaDeMensajes"
                     ItemsSource="{Binding Mensajes}"
                     Background="Transparent"
                     DoubleTapped="AlHacerDobleClicEnMensaje">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="consultas:MensajeDeEjecucion">
                        <SelectableTextBlock Classes="Mensaje"
                                             Classes.Error="{Binding EsError}"
                                             Classes.Advertencia="{Binding EsAdvertencia}"
                                             Text="{Binding Texto}"
                                             TextWrapping="Wrap"
                                             FontFamily="{StaticResource FuenteMonoespaciada}"
                                             FontSize="12.5" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </TabItem>

        <TabItem Header="Plan de ejecución" IsVisible="{Binding TienePlan}">
            <DockPanel DataContext="{Binding Plan}" x:DataType="planes:PlanDeEjecucionModeloDeVista">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,6">
                    <TextBlock Text="{Binding Tipo}" VerticalAlignment="Center" Foreground="{DynamicResource PincelDeTextoSecundario}" />
                    <Button Grid.Column="1" Classes="Herramienta" Content="Copiar XML" Command="{Binding CopiarXmlCommand}" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Margin="12,4" IsVisible="{Binding NoTieneInstrucciones}"
                           Foreground="{DynamicResource PincelDeTextoSecundario}"
                           Text="Las instrucciones ejecutadas no generan un plan (por ejemplo SET, DECLARE o USE)." />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Instrucciones}" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="planes:InstruccionDelPlanModeloDeVista">
                                <StackPanel Margin="4,6" Spacing="4">
                                    <TextBlock Text="{Binding Encabezado}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Texto}" FontFamily="{StaticResource FuenteMonoespaciada}" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource PincelDeTextoSecundario}" />
                                    <TextBlock Text="{Binding Advertencias}" IsVisible="{Binding TieneAdvertencias}"
                                               Foreground="{DynamicResource PincelDeAdvertencia}" TextWrapping="Wrap" />
                                    <TreeView ItemsSource="{Binding Raices}" Background="Transparent">
                                        <TreeView.Styles>
                                            <Style Selector="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="True" />
                                            </Style>
                                        </TreeView.Styles>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="planes:NodoDelPlanModeloDeVista" ItemsSource="{Binding Hijos}">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="84" Height="8" VerticalAlignment="Center" CornerRadius="2"
                                                            Background="{DynamicResource PincelDePanelElevado}">
                                                        <Border HorizontalAlignment="Left" CornerRadius="2"
                                                                Width="{Binding AnchoDeLaBarraDeCosto}"
                                                                Background="{DynamicResource PincelDeAcento}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Costo}" Width="52" VerticalAlignment="Center"
                                                               FontWeight="{Binding EsCostosa, Converter={x:Static conv:BooleanoANegrita.Instancia}}" />
                                                    <TextBlock Text="{Binding Operacion}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Objeto}" IsVisible="{Binding TieneObjeto}" VerticalAlignment="Center"
                                                               Foreground="#61AFEF" />
                                                    <TextBlock Text="{Binding Filas}" VerticalAlignment="Center" FontSize="11.5"
                                                               Foreground="{DynamicResource PincelDeTextoSecundario}" />
                                                    <TextBlock Text="Estimación muy distinta a lo real" IsVisible="{Binding EstimacionMuyDiferente}"
                                                               VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource PincelDeAdvertencia}" />
                                                    <TextBlock Text="{Binding Advertencias}" IsVisible="{Binding TieneAdvertencias}"
                                                               VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource PincelDeAdvertencia}" />
                                                </StackPanel>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YoshiSQL.Escritorio.ModelosDeVista.EdicionDeFilas"
             xmlns:vistas="using:YoshiSQL.Escritorio.Vistas.EdicionDeFilas"
             x:Class="YoshiSQL.Escritorio.Vistas.EdicionDeFilas.PestanaDeEdicionDeFilas"
             x:DataType="vm:PestanaDeEdicionDeFilasModeloDeVista">

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PincelDePanel}"
                BorderBrush="{DynamicResource PincelDeBorde}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <Grid ColumnDefinitions="Auto,220,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="Herramienta" Content="Agregar fila" Command="{Binding AgregarFilaCommand}" />
                    <Button Classes="Herramienta" Content="Eliminar fila" Command="{Binding EliminarFilaCommand}" />
                    <Button Classes="Herramienta" Content="Recargar" Command="{Binding CargarCommand}" />
                </StackPanel>

                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding FiltroDeFilas}"
                         PlaceholderText="Filtrar filas cargadas..."
                         ToolTip.Tip="Oculta al instante las filas que no contengan este texto (no vuelve a consultar)" />

                <TextBlock Grid.Column="2" Margin="16,0" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource PincelDeTextoSecundario}" TextTrimming="CharacterEllipsis"
                           Text="Amarillo: modificada · Verde: nueva · Rojo: se eliminará" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                    <CheckBox Content="Guardar al cambiar de fila" IsChecked="{Binding GuardarAlCambiarDeFila}" VerticalAlignment="Center"
                              ToolTip.Tip="Guarda cada fila modificada al salir de ella (las filas nuevas se guardan con el botón)" />
                    <Button Classes="Primario" Content="Guardar cambios" Command="{Binding GuardarCambiosCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PincelDePanel}"
                BorderBrush="{DynamicResource PincelDeBorde}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="Auto,2*,Auto,1*,Auto">
                <TextBlock Text="WHERE" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource PincelDeTextoSecundario}" FontSize="11.5" />
                <TextBox Grid.Column="1" Text="{Binding FiltroWhere}"
                         PlaceholderText="ej. Ciudad = 'Lima' AND Activo = 1"
                         ToolTip.Tip="Condición del WHERE, sin escribir la palabra WHERE" />

                <TextBlock Grid.Column="2" Text="ORDER BY" VerticalAlignment="Center" Margin="12,0,6,0"
                           Foreground="{DynamicResource PincelDeTextoSecundario}" FontSize="11.5" />
                <TextBox Grid.Column="3" Text="{Binding OrdenarPor}"
                         PlaceholderText="ej. Fecha DESC"
                         ToolTip.Tip="Columnas del ORDER BY, sin escribir las palabras ORDER BY" />

                <Button Grid.Column="4" Classes="Herramienta" Content="Aplicar filtro" Margin="8,0,0,0"
                        Command="{Binding CargarCommand}" IsDefault="True" />
            </Grid>
        </Border>

        <vistas:GrillaDeEdicion />
    </DockPanel>
</UserControl>

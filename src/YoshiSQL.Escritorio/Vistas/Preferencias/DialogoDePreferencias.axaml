<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YoshiSQL.Escritorio.ModelosDeVista.Preferencias"
        x:Class="YoshiSQL.Escritorio.Vistas.Preferencias.DialogoDePreferencias"
        x:DataType="vm:DialogoDePreferenciasModeloDeVista"
        Title="Preferencias"
        Width="520" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24,20" Spacing="16">
        <TextBlock Text="Preferencias" FontSize="18" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Text="Tema" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding OpcionesDeTema}" SelectedItem="{Binding TemaSeleccionado}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcionDeTema">
                        <TextBlock Text="{Binding Descripcion}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Letra del editor" VerticalAlignment="Center" />
            <AutoCompleteBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding FuenteDelEditor}"
                             ItemsSource="{Binding FuentesInstaladas}"
                             FilterMode="Contains"
                             ToolTip.Tip="Puedes escribir varias separadas por comas; se usa la primera que esté instalada" />

            <TextBlock Grid.Row="2" Text="Tamaño de letra" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="140"
                           Value="{Binding TamanoDeLetraDelEditor}"
                           Minimum="{Binding TamanoMinimo}" Maximum="{Binding TamanoMaximo}" Increment="1" FormatString="0" />

            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                <CheckBox Content="Mostrar números de línea" IsChecked="{Binding MostrarNumerosDeLinea}" />
                <CheckBox Content="Ajustar líneas largas al ancho del editor" IsChecked="{Binding AjustarLineasLargas}" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Filas al seleccionar" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Width="140"
                           Value="{Binding FilasAlSeleccionar}"
                           Minimum="{Binding FilasMinimas}" Maximum="{Binding FilasMaximas}" Increment="100" FormatString="0"
                           ToolTip.Tip="Filas que trae &quot;Seleccionar las primeras N filas&quot;" />

            <TextBlock Grid.Row="5" Text="Filas al editar" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Width="140"
                           Value="{Binding FilasAlEditar}"
                           Minimum="{Binding FilasMinimas}" Maximum="{Binding FilasMaximas}" Increment="50" FormatString="0"
                           ToolTip.Tip="Filas que trae &quot;Editar las primeras N filas&quot;" />
        </Grid>

        <TextBlock Text="{Binding MensajeDeError}" Foreground="{DynamicResource PincelDeError}" TextWrapping="Wrap"
                   IsVisible="{Binding MensajeDeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Content="Restablecer" Command="{Binding RestablecerPredeterminadasCommand}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="Primario" Content="Guardar" MinWidth="100" IsDefault="True" Command="{Binding GuardarCommand}" />
                <Button Content="Cancelar" MinWidth="100" IsCancel="True" Command="{Binding CancelarCommand}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>

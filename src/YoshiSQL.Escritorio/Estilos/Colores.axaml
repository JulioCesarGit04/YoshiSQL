<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!--
        Paleta de YoshiSQL en sus dos versiones. Las vistas usan siempre DynamicResource
        para que el cambio de tema se aplique al instante sin reiniciar.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PincelDeFondo" Color="#17191C" />
            <SolidColorBrush x:Key="PincelDePanel" Color="#1F2124" />
            <SolidColorBrush x:Key="PincelDePanelElevado" Color="#26292D" />
            <SolidColorBrush x:Key="PincelDeBorde" Color="#33363B" />
            <SolidColorBrush x:Key="PincelDeTexto" Color="#E4E6EA" />
            <SolidColorBrush x:Key="PincelDeTextoSecundario" Color="#959BA3" />
            <SolidColorBrush x:Key="PincelDeAcento" Color="#6CC24A" />
            <SolidColorBrush x:Key="PincelDeTextoSobreAcento" Color="#10130F" />
            <SolidColorBrush x:Key="PincelDeError" Color="#F07178" />
            <SolidColorBrush x:Key="PincelDeAdvertencia" Color="#E5C07B" />
            <SolidColorBrush x:Key="PincelDeEncabezadoDeTarjeta" Color="#30353C" />
            <SolidColorBrush x:Key="PincelDeBordeDeTarjeta" Color="#3C4148" />
            <SolidColorBrush x:Key="PincelDeLineaDeRelacion" Color="#C08B93A0" />
            <SolidColorBrush x:Key="PincelDeNumerosDeLinea" Color="#5C6370" />
            <SolidColorBrush x:Key="PincelDeHover" Color="#FFFFFF" Opacity="0.055" />
            <SolidColorBrush x:Key="PincelDeAcentoSuave" Color="#6CC24A" Opacity="0.20" />
            <SolidColorBrush x:Key="PincelDeSeleccion" Color="#6CC24A" Opacity="0.28" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PincelDeFondo" Color="#FBFBFC" />
            <SolidColorBrush x:Key="PincelDePanel" Color="#F0F2F5" />
            <SolidColorBrush x:Key="PincelDePanelElevado" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PincelDeBorde" Color="#D5D9DF" />
            <SolidColorBrush x:Key="PincelDeTexto" Color="#1F2328" />
            <SolidColorBrush x:Key="PincelDeTextoSecundario" Color="#5F6670" />
            <SolidColorBrush x:Key="PincelDeAcento" Color="#3E8E2A" />
            <SolidColorBrush x:Key="PincelDeTextoSobreAcento" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PincelDeError" Color="#C8323C" />
            <SolidColorBrush x:Key="PincelDeAdvertencia" Color="#9A6700" />
            <SolidColorBrush x:Key="PincelDeEncabezadoDeTarjeta" Color="#E8EBEF" />
            <SolidColorBrush x:Key="PincelDeBordeDeTarjeta" Color="#C9CED6" />
            <SolidColorBrush x:Key="PincelDeLineaDeRelacion" Color="#B05F6672" />
            <SolidColorBrush x:Key="PincelDeNumerosDeLinea" Color="#9AA0A6" />
            <SolidColorBrush x:Key="PincelDeHover" Color="#000000" Opacity="0.05" />
            <SolidColorBrush x:Key="PincelDeAcentoSuave" Color="#3E8E2A" Opacity="0.14" />
            <SolidColorBrush x:Key="PincelDeSeleccion" Color="#3E8E2A" Opacity="0.20" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="FuenteMonoespaciada">Cascadia Code, Consolas, JetBrains Mono, Ubuntu Mono, DejaVu Sans Mono, monospace</FontFamily>

    <!-- Valores iniciales del editor; se reemplazan con las preferencias del usuario al iniciar -->
    <FontFamily x:Key="FuenteDelEditor">Cascadia Code, Consolas, JetBrains Mono, Ubuntu Mono, DejaVu Sans Mono, monospace</FontFamily>
    <sys:Double x:Key="TamanoDeLetraDelEditor">14</sys:Double>
    <sys:Boolean x:Key="MostrarNumerosDeLinea">True</sys:Boolean>
    <sys:Boolean x:Key="AjustarLineasLargas">False</sys:Boolean>
</ResourceDictionary>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YoshiSQL.Escritorio.Controles.LogoDeYoshiSql">

    <Grid>
        <Border CornerRadius="22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#36C06F" Offset="0" />
                    <GradientStop Color="#1C8A58" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Cilindro de base de datos -->
        <Viewbox Margin="26" Stretch="Uniform">
            <Canvas Width="18" Height="18">
                <Path Stroke="White" StrokeThickness="1.3"
                      StrokeJoin="Round" StrokeLineCap="Round"
                      Data="M4,5 C4,3 14,3 14,5 V13 C14,15 4,15 4,13 Z M4,5 C4,7 14,7 14,5 M4,9 C4,11 14,11 14,9">
                    <Path.Fill>
                        <SolidColorBrush Color="White" Opacity="0.18" />
                    </Path.Fill>
                </Path>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
